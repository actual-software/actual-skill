{
  "description": "Actual plan- and implementation-stage ADR governance: checks implementation plans and accumulated diffs against the rules committed in .actual/rules/.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/preflight.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/plan-gate.sh",
            "timeout": 180,
            "statusMessage": "Checking plan against architecture rules..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/impl-gate.sh",
            "timeout": 180,
            "statusMessage": "Checking implementation against architecture rules..."
          }
        ]
      }
    ]
  }
}
